# --- AI (required) ---
ANTHROPIC_API_KEY=
# live (default when a key is set) | mock (labelled placeholder output, no paid calls) | off
AI_MODE=

# --- Research ---
# Recommended: Tavily's free tier (~1,000 searches/month) makes research free.
TAVILY_API_KEY=
# tavily | anthropic | none   (default: tavily if TAVILY_API_KEY is set, otherwise anthropic)
RESEARCH_PROVIDER=

# --- Models (optional overrides) ---
MODEL_PLAYBOOK=claude-sonnet-5-5
MODEL_RESEARCH=claude-haiku-5-5
EFFORT_PLAYBOOK=medium

# --- Wallet protection for a public, no-sign-up tool ---
PLAYBOOKS_PER_VISITOR_PER_DAY=3
PLAYBOOKS_PER_DAY=40
MONTHLY_BUDGET_USD=15

# --- Admin dashboard (/admin, HTTP Basic auth, any username) ---
ADMIN_PASSWORD=
# Salt for hashing visitor IPs for rate limiting (any random string)
HASH_SALT=

# --- Database ---
# Leave empty to use embedded PGlite (Postgres in WASM) at PGLITE_DIR.
DATABASE_URL=
PGLITE_DIR=.data/pglite
